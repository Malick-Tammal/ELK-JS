{
  "name": "ELK-JS",
  "version": "1.0.0",
  "description": "A lightweight Node.js tool to control generic ELK-BLEDOM Bluetooth LED strips directly from your laptop.",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "bin": {
    "elk-js": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "prepare": "tsc",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "color": "pnpm dev color",
    "brightness": "pnpm dev brightness",
    "on": "pnpm dev on",
    "off": "pnpm dev off",
    "picker": "pnpm dev picker",
    "daemon": "pnpm dev daemon",
    "daemon:start": "pnpm dev daemon start",
    "daemon:stop": "pnpm dev daemon stop",
    "daemon:status": "pnpm dev daemon status"
  },
  "author": "Malick Tammal",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "node-ble": "^1.13.0"
  }
}
